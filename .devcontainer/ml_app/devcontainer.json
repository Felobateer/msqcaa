{
  "name": "ML Dev",
  "dockerComposeFile": ["../../docker-compose.yml"],
  "service": "ml_env",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg"
      ],
      "settings": {
        "git.terminalAuthentication": true,
        "github.gitAuthentication": true
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  }
}